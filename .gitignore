.vault_pass
*.retry
inventory/group_vars/all/vault.yml.bak
.env
*.pyc
__pycache__/
.vagrant/
terraform.tfvars
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/*.tfvars
!**/example.tfvars

# Terraform Proxmox (specifique - couverts aussi par les patterns globaux ci-dessus)
terraform/environments/proxmox/terraform.tfvars
terraform/environments/proxmox/.terraform/
terraform/environments/proxmox/*.tfstate*
terraform/environments/proxmox/.terraform.lock.hcl
tfplan
tfplan-*

# automation pipeline local config
.automation/
**/.automation/

# Local backups (sauf group_vars Ansible)
backups/
!inventory/group_vars/backups/
.DS_Store

# Certificates and keys (NEVER commit private keys)
*.pem
*.crt
*.key
*.csr
*.p12
*.pfx

# Local certs working dir
_certs-LOCAL-DO-NOT-COMMIT/
**/certs-LOCAL/

# Vault rotation backups (T-VAULT-PLAINTEXT-FIX-2026-05-18)
*.PLAINTEXT-BACKUP-*
*.OLDENC-BACKUP-*
