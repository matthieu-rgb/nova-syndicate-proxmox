# Nova Syndicate — MariaDB (Ansible managed)
[mysqld]
bind-address            = {{ mariadb_bind_address }}
port                    = {{ mariadb_port }}
max_connections         = {{ mariadb_max_connections }}
character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# InnoDB
innodb_buffer_pool_size = {{ mariadb_innodb_buffer }}
innodb_log_file_size    = 256M
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table   = 1

# PITR — Binary logs
{% if mariadb_log_bin %}
log_bin                 = {{ db_binlog_path }}/mariadb-bin
binlog_format           = {{ mariadb_binlog_format }}
expire_logs_days        = {{ mariadb_expire_logs_days }}
sync_binlog             = {{ mariadb_sync_binlog }}
server_id               = 1
{% endif %}

# Securite
local_infile            = 0
skip_symbolic_links     = yes
sql_mode                = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION

{% if mariadb_audit_enable %}
# Audit NIS2
plugin_load_add         = server_audit
server_audit_logging    = ON
server_audit_events     = {{ mariadb_audit_events }}
server_audit_output_type = file
server_audit_file_path  = /var/log/mysql/server_audit.log
{% if mariadb_audit_log_rotate %}
server_audit_file_rotate_size   = 100M
server_audit_file_rotations     = 12
{% endif %}
{% endif %}

# Logging
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/mariadb-slow.log
long_query_time         = 2
