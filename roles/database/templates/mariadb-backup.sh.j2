#!/bin/bash
# Nova Syndicate — Dump MariaDB toutes les 15 min (Ansible managed)
# RPO = 15 min (dump) / ~0 avec PITR via binlogs
set -euo pipefail

DUMP_DIR="{{ db_dump_path }}"
DATE=$(date +%Y%m%d-%H%M)
DUMP_FILE="${DUMP_DIR}/all-databases-${DATE}.sql.gz"

# Dump complet compresse
mariadb-dump \
  --user=backup_nova \
  --password="{{ vault_mariadb_backup_password }}" \
  --all-databases \
  --single-transaction \
  --routines \
  --triggers \
  --flush-logs \
  --master-data=2 \
  2>/dev/null | gzip > "${DUMP_FILE}"

# Rotation : garder {{ db_dump_retention }}h de dumps
find "${DUMP_DIR}" -name "all-databases-*.sql.gz" -mmin +{{ db_dump_retention * 60 }} -delete

# rsync vers BACKUP01
rsync -az "${DUMP_FILE}" {{ backup_rsync_user }}@{{ backup_nas_ip }}:/srv/backups/db01/

logger -t mariadb-backup "Dump MariaDB termine : ${DUMP_FILE}"
