# Nova Syndicate — krb5.conf (Ansible managed)
[libdefaults]
    default_realm = {{ nova_realm }}
    dns_lookup_realm = false
    dns_lookup_kdc = true
    ticket_lifetime = {{ krb5_ticket_lifetime }}
    renew_lifetime = {{ krb5_renew_lifetime }}
    forwardable = {{ krb5_forwardable | lower }}

[realms]
    {{ nova_realm }} = {
        kdc = dc01.{{ nova_domain }}
        admin_server = dc01.{{ nova_domain }}
        default_domain = {{ nova_domain }}
    }

[domain_realm]
    .{{ nova_domain }} = {{ nova_realm }}
    {{ nova_domain }} = {{ nova_realm }}
